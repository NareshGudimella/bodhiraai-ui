# NestJS API (bodhiraai-api). Server-side only; never exposed to the browser.
API_URL=http://localhost:4000/api/v1
# Legacy Laravel app: still serves uploaded media (/media, /cloud) and the marketing pages until those phases migrate.
LEGACY_URL=http://localhost:8001
# Public site URL (canonical and Open Graph URLs).
SITE_URL=http://localhost:3000
# Behind Cloudflare: sent with the visitor's IP (X-Client-IP) so the API believes it. Same value as the API's. Unset locally.
PROXY_SECRET=
